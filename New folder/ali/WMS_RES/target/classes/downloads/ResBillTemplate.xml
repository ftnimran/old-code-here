        <label ref="jr:itext('/data/workDetails/workName:label')"/>
      </input>
      <input ref="/data/workDetails/executionAgency">
        <label ref="jr:itext('/data/workDetails/executionAgency:label')"/>
      </input>
      <input ref="/data/workDetails/workType">
