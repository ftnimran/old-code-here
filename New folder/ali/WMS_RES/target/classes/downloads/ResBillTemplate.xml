      </input>
      <input ref="/data/workDetails/workSubType">
        <label ref="jr:itext('/data/workDetails/workSubType:label')"/>
        <hint ref="jr:itext('/data/workDetails/workSubType:hint')"/>
      </input>
    </group>
    <group ref="/data/bill" appearance="field-list">
      <label ref="jr:itext('/data/bill:label')"/>
      <input ref="/data/bill/billNo">
        <label ref="jr:itext('/data/bill/billNo:label')"/>
      </input>
      <input ref="/data/bill/billType">
        <label ref="jr:itext('/data/bill/billType:label')"/>
      </input>
    </group>
    <group ref="/data/billItems">
      <label ref="jr:itext('/data/billItems:label')"/>
