        <group appearance="field-list">
          <input ref="/data/billItems/unit">
            <label ref="jr:itext('/data/billItems/unit:label')"/>
          </input>
          <input ref="/data/billItems/quantityUptodate">
            <label ref="jr:itext('/data/billItems/quantityUptodate:label')"/>
          </input>
          <input ref="/data/billItems/actualQuantity">
