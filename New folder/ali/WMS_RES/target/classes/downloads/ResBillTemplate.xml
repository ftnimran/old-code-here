          </input>
          <input ref="/data/billItems/itemOfWork">
            <label ref="jr:itext('/data/billItems/itemOfWork:label')"/>
            <hint ref="jr:itext('/data/billItems/itemOfWork:hint')"/>
          </input>
          <select1 ref="/data/billItems/grading">
            <label ref="jr:itext('/data/billItems/grading:label')"/>
            <item>
              <label ref="jr:itext('/data/billItems/grading:option0')"/>
              <value>S</value>
            </item>
            <item>
              <label ref="jr:itext('/data/billItems/grading:option1')"/>
              <value>SRI</value>
            </item>
            <item>
              <label ref="jr:itext('/data/billItems/grading:option2')"/>
